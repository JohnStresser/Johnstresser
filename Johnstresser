
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TOWZZ NETWORK LAB</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #080d0a;
    color: #eaffef;
    font-family: Arial, sans-serif;
    min-height: 100vh;
}

header {
    background: #101b13;
    border-bottom: 1px solid #235b35;
    padding: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: #36e875;
    font-size: 23px;
    font-weight: bold;
    letter-spacing: 2px;
}

.header-status {
    color: #36e875;
    font-size: 12px;
}

.container {
    max-width: 1050px;
    margin: 35px auto;
    padding: 15px;
}

.heading {
    margin-bottom: 25px;
}

.heading h1 {
    font-size: 27px;
    margin-bottom: 8px;
}

.heading p {
    color: #8da997;
    font-size: 13px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.panel {
    background: #101a13;
    border: 1px solid #244a30;
    border-radius: 12px;
    padding: 22px;
}

.panel h2 {
    font-size: 15px;
    color: #43e77c;
    margin-bottom: 20px;
}

label {
    display: block;
    color: #a6b9aa;
    font-size: 12px;
    margin: 15px 0 8px;
}

input, select {
    width: 100%;
    background: #080e0a;
    border: 1px solid #315b3c;
    border-radius: 7px;
    padding: 13px;
    color: white;
    outline: none;
}

input:focus, select:focus {
    border-color: #36e875;
}

select option {
    background: #101a13;
}

.metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.metric {
    background: #080e0a;
    border: 1px solid #1d3925;
    border-radius: 8px;
    padding: 17px;
}

.metric small {
    color: #8da997;
    font-size: 11px;
}

.metric h3 {
    color: #42ed7d;
    font-size: 25px;
    margin-top: 10px;
}

.status {
    margin-top: 20px;
    background: #080e0a;
    padding: 15px;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
}

#status {
    color: #ff6464;
    font-weight: bold;
}

.buttons {
    display: flex;
    gap: 12px;
    margin-top: 20px;
}

button {
    flex: 1;
    padding: 15px;
    border: none;
    border-radius: 7px;
    font-weight: bold;
    cursor: pointer;
    transition: .2s;
}

.start {
    background: #32df70;
    color: #061109;
}

.start:hover {
    background: #64f596;
}

.stop {
    background: #c83b3b;
    color: white;
}

.stop:hover {
    background: #ed5151;
}

button:disabled {
    opacity: .4;
    cursor: not-allowed;
}

.log {
    margin-top: 18px;
    background: #080e0a;
    padding: 15px;
    border-radius: 8px;
    min-height: 90px;
    color: #9bb5a2;
    font-size: 12px;
    line-height: 2;
    overflow-wrap: anywhere;
}

footer {
    text-align: center;
    padding: 25px;
    color: #64816d;
    font-size: 11px;
}

.notice {
    color: #a5b9aa;
    font-size: 11px;
    line-height: 1.6;
    margin-top: 15px;
}

@media(max-width:650px) {
    .grid {
        grid-template-columns: 1fr;
    }

    header {
        padding: 17px;
    }

    .logo {
        font-size: 17px;
    }

    .container {
        margin-top: 20px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">TOWZZ NETWORK LAB</div>
    <div class="header-status">● LOCAL DEMO</div>
</header>

<div class="container">

    <div class="heading">
        <h1>Network Control Panel</h1>
        <p>Authorized network diagnostics and simulated monitoring.</p>
    </div>

    <div class="grid">

        <!-- CONFIGURATION -->

        <section class="panel">
            <h2>CONFIGURATION</h2>

            <label>Target IPv4 Address</label>
            <input
                type="text"
                id="ip"
                value="127.0.0.1"
                placeholder="127.0.0.1"
            >

            <label>Target Port</label>
            <input
                type="number"
                id="port"
                value="8080"
                min="1"
                max="65535"
                placeholder="8080"
            >

            <label>Concurrent Users (1–5)</label>
            <select id="concurrent">
                <option value="1">1 Concurrent</option>
                <option value="2">2 Concurrent</option>
                <option value="3">3 Concurrent</option>
                <option value="4">4 Concurrent</option>
                <option value="5">5 Concurrent</option>
            </select>

            <label>Diagnostic Method</label>
            <select id="method">
                <option value="udp-free">UDP-FREE</option>
                <option value="http">HTTP Monitor</option>
                <option value="tcp">TCP Monitor</option>
            </select>

            <p class="notice">
                This is a simulated interface. The method selector
                does not send UDP, TCP, or HTTP traffic.
            </p>

            <div class="buttons">
                <button class="start" id="startBtn"
                    onclick="startMonitor()">START</button>

                <button class="stop" id="stopBtn"
                    onclick="stopMonitor()" disabled>STOP</button>
            </div>
        </section>

        <!-- MONITOR -->

        <section class="panel">
            <h2>LIVE MONITOR</h2>

            <div class="metrics">

                <div class="metric">
                    <small>Runtime</small>
                    <h3 id="time">0s</h3>
                </div>

                <div class="metric">
                    <small>Simulated Requests</small>
                    <h3 id="requests">0</h3>
                </div>

                <div class="metric">
                    <small>Concurrent Users</small>
                    <h3 id="users">0</h3>
                </div>

                <div class="metric">
                    <small>Simulated Latency</small>
                    <h3 id="latency">-- ms</h3>
                </div>

            </div>

            <div class="status">
                <span>System Status</span>
                <span id="status">STOPPED</span>
            </div>

            <div class="status">
                <span>Selected Method</span>
                <span id="selectedMethod">UDP-FREE</span>
            </div>

            <div class="log" id="log">
                [SYSTEM] TOWZZ NETWORK LAB initialized.<br>
                [SYSTEM] Waiting for start command.
            </div>

        </section>

    </div>

</div>

<footer>
    TOWZZ NETWORK LAB © 2026<br>
    Local simulation only. No attack traffic is generated.
</footer>

<script>

let running = false;
let timer = null;
let seconds = 0;
let requests = 0;

const ipInput = document.getElementById("ip");
const portInput = document.getElementById("port");
const concurrentInput = document.getElementById("concurrent");
const methodInput = document.getElementById("method");

function validIPv4(ip) {
    const parts = ip.split(".");

    return parts.length === 4 &&
        parts.every(part =>
            /^\d{1,3}$/.test(part) &&
            Number(part) >= 0 &&
            Number(part) <= 255
        );
}

function addLog(message) {
    const log = document.getElementById("log");

    const line = document.createElement("div");
    line.textContent = message;

    log.appendChild(line);

    while (log.children.length > 12) {
        log.removeChild(log.firstChild);
    }
}

function startMonitor() {

    if (running) return;

    const ip = ipInput.value.trim();
    const port = Number(portInput.value);
    const users = Number(concurrentInput.value);
    const method = methodInput.value;

    if (!validIPv4(ip)) {
        alert("Please enter a valid IPv4 address.");
        return;
    }

    if (!Number.isInteger(port) || port < 1 || port > 65535) {
        alert("Port must be between 1 and 65535.");
        return;
    }

    if (!Number.isInteger(users) || users < 1 || users > 5) {
        alert("Select between 1 and 5 simulated users.");
        return;
    }

    seconds = 0;
    requests = 0;
    running = true;

    document.getElementById("startBtn").disabled = true;
    document.getElementById("stopBtn").disabled = false;

    document.getElementById("status").textContent = "RUNNING";
    document.getElementById("status").style.color = "#42ed7d";

    document.getElementById("users").textContent = users;
    document.getElementById("selectedMethod").textContent =
        method.toUpperCase();

    addLog("[SYSTEM] Simulation started.");
    addLog("[CONFIG] Target: " + ip + ":" + port);
    addLog("[CONFIG] Simulated users: " + users);
    addLog("[CONFIG] Method: " + method.toUpperCase());

    timer = setInterval(() => {

        if (!running) return;

        seconds++;

        // Simulated values only.
        requests += users;

        const latency = Math.floor(
            Math.random() * 30 + 10
        );

        document.getElementById("time").textContent =
            seconds + "s";

        document.getElementById("requests").textContent =
            requests.toLocaleString();

        document.getElementById("latency").textContent =
            latency + " ms";

        if (seconds % 5 === 0) {
            addLog("[MONITOR] Simulated monitoring update.");
        }

    }, 1000);
}

function stopMonitor() {

    if (!running) return;

    running = false;

    clearInterval(timer);
    timer = null;

    document.getElementById("startBtn").disabled = false;
    document.getElementById("stopBtn").disabled = true;

    document.getElementById("status").textContent = "STOPPED";
    document.getElementById("status").style.color = "#ff6464";

    document.getElementById("users").textContent = "0";

    addLog("[SYSTEM] Simulation stopped.");
}

</script>

</body>
</html>
